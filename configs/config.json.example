{
    "favorite_papers_path": "favorite_papers.json",
    "vectorizer": {
        "module_name": "huggingface_embed",
        "class_name": "HuggingFaceEmbedding",
        "model_name": "BAAI/bge-small-en-v1.5",
        "cache_size": 1000,
        "pooling_strategy": "auto",
        "normalize_embeddings": "auto",
        "max_length": 512
    },
    "top_k": 10,
    "log_level": "INFO"
}
